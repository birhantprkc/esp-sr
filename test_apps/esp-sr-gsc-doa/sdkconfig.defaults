# SDK configuration for DOA Capon Embedded Accuracy Test on ESP32-P4

# PSRAM (octal, 80MHz)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SIZE=-1
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# CPU frequency: 400MHz (requires chip rev >= v3.0)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Enable float printf
CONFIG_NEWLIB_NANO_FORMAT=n

CONFIG_MAIN_TASK_STACK_SIZE=16384

# Bootloader size optimization (bootloader exceeded 0x6000 limit on esp32p4)
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Custom partition table (app > 1MB due to embedded test data)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
